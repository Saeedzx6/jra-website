# Local dev default (docker-compose.yml). For production, point to Neon (or your chosen host).
# On Neon these are two different hosts: DATABASE_URL is the pooled one (its
# hostname contains "-pooler"), DIRECT_URL is the plain one used by migrations.
DATABASE_URL="postgresql://jra:jra_dev_password@localhost:5433/jra?schema=public"
DIRECT_URL="postgresql://jra:jra_dev_password@localhost:5433/jra?schema=public"

# Auth.js — generate a real one with: npx auth secret
AUTH_SECRET="replace-with-a-real-secret"
# No NEXTAUTH_URL needed — trustHost in lib/auth.ts infers the origin from
# the request, which is more robust in dev where the port can vary.

# Nightly membership sweep (GOOD -> GRACE -> LAPSED), scheduled in vercel.json.
# Vercel signs cron requests with this as a bearer token. Leave blank locally:
# without it /api/cron/membership-sweep returns 503 rather than running open,
# which is the intended default since it rewrites every member's standing.
CRON_SECRET=""

# Cloudinary (image/PDF hosting) — leave blank in early dev; seed scripts fall back to local paths
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Absolute path to the reference data dumps (read by prisma/seed scripts only, never shipped)
JRA_LEGACY_DATA_DIR="C:\\Users\\dvd\\Desktop\\project\\JRA"
JRA_ASSETS_DATA_DIR="C:\\Users\\dvd\\Desktop\\project\\JRA-moreassets\\JRA"
