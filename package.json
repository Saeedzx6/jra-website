{
  "name": "jra-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed:lookups": "tsx prisma/seed/01-lookups.ts",
    "seed:restaurants": "tsx prisma/seed/02-restaurants.ts",
    "seed:images": "tsx prisma/seed/03-images.ts",
    "seed:photos": "tsx prisma/seed/07-restaurant-photos.ts",
    "seed:photos-csv": "tsx prisma/seed/09-restaurant-photos-csv.ts",
    "seed:contacts": "tsx prisma/seed/12-restaurant-contacts.ts",
    "seed:dues": "tsx prisma/seed/13-dues-schedule.ts",
    "seed:geocode": "tsx prisma/seed/14-geocode-restaurants.ts",
    "seed:content": "tsx prisma/seed/04-content.ts",
    "seed:classification": "tsx prisma/seed/05-classification.ts",
    "seed:admin": "tsx prisma/seed/06-admin-user.ts",
    "migrate:images": "tsx prisma/seed/10-migrate-images-to-cloudinary.ts",
    "seed:prod-admin": "tsx prisma/seed/11-prod-admin.ts",
    "env:check": "node scripts/check-env.mjs",
    "prod:migrate-images": "dotenv -e .env.production.local -- tsx prisma/seed/10-migrate-images-to-cloudinary.ts",
    "prod:admin": "dotenv -e .env.production.local -- tsx prisma/seed/11-prod-admin.ts",
    "prod:studio": "dotenv -e .env.production.local -- prisma studio",
    "seed:all": "npm run seed:lookups && npm run seed:restaurants && npm run seed:images && npm run seed:content && npm run seed:classification && npm run seed:admin"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.3.0",
    "next": "^15.5.21",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^3.26.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sanitize-html": "^2.14.0",
    "slugify": "^1.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.13.0",
    "csv-parse": "^5.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.4",
    "fast-levenshtein": "^3.0.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  }
}
